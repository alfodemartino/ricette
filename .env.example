# Database Postgres. In sviluppo va bene un'istanza qualsiasi; nei container è
# il servizio `db` del docker-compose.yml, e l'host è quindi `db` (quello di
# Ricette: il `db` di finanze sta su un'altra rete e da qui non si vede):
#   postgresql://ricette:<POSTGRES_PASSWORD>@db:5432/ricette
#
# Dentro la rete di Compose la porta resta 5432: la 5433 è solo quella
# pubblicata sull'LXC per i client SQL.
#
# Niente `?schema=public`: è un parametro che conosce solo Prisma (e che vale
# già di default), mentre la stessa stringa la usano anche pg_dump e
# pg_restore nel servizio `backup`, che lo rifiutano: con quel parametro
# fallirebbe ogni backup notturno.
DATABASE_URL="postgresql://ricette:password@localhost:5432/ricette"

# Password dell'utente `ricette` del database nei container. Deve coincidere
# con quella dentro DATABASE_URL. Generane una esadecimale, così non contiene
# caratteri da proteggere nell'URL:  openssl rand -hex 24
# Va decisa prima del primo avvio: il database la fissa alla creazione del
# volume, e cambiarla dopo qui non la cambia nel database.
POSTGRES_PASSWORD=""

# Chiave usata da Auth.js per firmare i cookie di sessione. Diversa da quella
# di finanze: sono due app con due elenchi di utenti.
# Generane una con: npx auth secret   (oppure: openssl rand -base64 32)
# Cambiarla scollega tutte le sessioni attive; le password non ne risentono.
AUTH_SECRET=""

# URL pubblico dell'applicazione. In sviluppo va bene questo.
#
# In produzione dipende da come si raggiunge l'app:
#   - solo dalla LAN, per indirizzo IP  ->  lasciarlo VUOTO. Il codice imposta
#     `trustHost: true`, quindi Auth.js ricava l'host da ogni richiesta.
#     Fissarlo romperebbe tutti gli indirizzi diversi da quello scritto qui.
#   - dietro un dominio pubblico  ->  valorizzarlo con quello (https://…).
AUTH_URL="http://localhost:3000"

# Facoltativo: se valorizzate, in pagina di login compare "Continua con Google".
# L'URL di callback da registrare è <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cartella delle foto delle ricette. In sviluppo una cartella del progetto
# (ignorata da git); nel container è fissata dal Dockerfile su /app/uploads,
# dove è montato il volume `uploads`, e qui non serve.
# UPLOADS_DIR="./uploads"

# Riservata a un'estensione futura: l'import da link con Claude, per i video e
# le pagine senza dati strutturati. Oggi non è letta da nessuna parte; il punto
# in cui agganciarla è `src/lib/import/index.ts`.
# ANTHROPIC_API_KEY=""

# --- Solo per l'esecuzione in container --------------------------------------

# Porte pubblicate sull'LXC. Diverse da quelle di finanze (3000 e 5432), che
# gira sulla stessa macchina.
# APP_PORT="3001"
# DB_PORT="5433"

# Indirizzo su cui il database accetta client SQL esterni (DBeaver, psql…).
# Vuoto o assente: solo 127.0.0.1, cioè l'LXC stesso o un tunnel SSH. Con l'IP
# di rete locale dell'LXC (vedi `hostname -I`) lo raggiunge la LAN. L'IP deve
# essere fisso: se cambia, `db` non parte e con lui l'app.
# DB_LAN_IP="192.168.1.50"

# Profili di Docker Compose da attivare. Vuoto (o assente) avvia la sola
# applicazione, raggiungibile dalla LAN. `public` accende anche il tunnel
# Cloudflare che la espone su internet.
# COMPOSE_PROFILES="public"

# Token del tunnel, da Cloudflare Zero Trust > Networks > Tunnels. Un tunnel
# suo, non quello di finanze. Serve solo con il profilo `public`.
# TUNNEL_TOKEN=""

# Dove `backup-db.sh` deposita le copie, e per quanti giorni le tiene.
# BACKUP_DIR="/var/backups/ricette"
# KEEP_DAYS="30"

# Immagine di Postgres, usata sia dal servizio `db` sia da `pg_dump`. Mai
# cambiare la versione maggiore (18 -> 19) solo qui: il server nuovo non vede i
# dati del vecchio e partirebbe vuoto. La procedura è nel README.
# PG_IMAGE="postgres:18"
